DEEPSEEK_API_KEY=

# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=

# OpenAI, or any OpenAI-compatible endpoint (add the provider in src/planner.py PROVIDERS)
OPENAI_API_KEY=
